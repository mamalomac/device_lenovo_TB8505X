# TB-8505X recovery init (adapted from stock init.recovery.mt6761.rc)

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1
    # Some tools expect /dev/block/bootdevice
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice

on fs
    # distinguish USB should connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2

on post-fs
    # don't reset when the power key is held (stock behaviour)
    write /sys/devices/platform/mt6357_gauge/kpdpwr_reset 0
